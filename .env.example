# Umgebungsvariablen des Terminbuchungstools.
# Lokal: Kopie als .env.local (legt der SessionStart-Hook an).
# Produktion (Hetzner): /etc/meetings/env (root:meetings, 0640) – gelesen von systemd
# (der Build läuft auf GitHub und braucht keine Geheimnisse). "Produktion:" nennt den Wert dort.
# NODE_ENV, APP_ENV=production, NEXT_TELEMETRY_DISABLED, HOSTNAME=127.0.0.1 und PORT=3003
# setzt die systemd-Unit selbst – nicht in /etc/meetings/env eintragen.

# ---------------------------------------------------------------
# Datenbank
# ---------------------------------------------------------------
# Direkte Postgres-Verbindung. Lokal: vorinstalliertes Postgres 16.
# Produktion: leer lassen und SUPABASE_DB_URL setzen.
DATABASE_URL=postgres://postgres:postgres@localhost:5432/terminbuchung_dev
# Nur für Tests (wird bei jedem Testlauf neu aufgebaut!). Immer eine LOKALE
# Datenbank mit Dev-Shims – nie Supabase (helpers.ts bricht sonst ab).
TEST_DATABASE_URL=postgres://postgres:postgres@localhost:5432/terminbuchung_test

# ---------------------------------------------------------------
# Supabase (Projekt pkegcsgnyicdxzivnijw)
# ---------------------------------------------------------------
# Erwartetes Projekt: Betriebsskripte brechen ab, wenn SUPABASE_URL auf ein anderes zeigt
SUPABASE_PROJECT_REF=pkegcsgnyicdxzivnijw
# Produktion: https://pkegcsgnyicdxzivnijw.supabase.co
SUPABASE_URL=
# Neue API-Schlüssel (Dashboard → Settings → API Keys). Alte Namen
# SUPABASE_ANON_KEY / SUPABASE_SERVICE_ROLE_KEY werden als Fallback gelesen.
SUPABASE_PUBLISHABLE_KEY=
# Nur serverseitig (Storage-Uploads, Auth-Admin). Nie an den Browser geben.
SUPABASE_SECRET_KEY=
# Direkte DB-Verbindung (Pooler-URL, Transaction-Modus, Port 6543). Nur auf dem
# Produktionsserver setzen – ist sie gesetzt, hat sie Vorrang vor DATABASE_URL.
SUPABASE_DB_URL=
# Persönlicher Zugangstoken für die Management API. Nur für Betriebsskripte
# (npm run supabase:inspect|migrate|seed|wipe), NICHT auf dem Server setzen.
SUPABASE_ACCESS_TOKEN=

# Ablage für Mandanten-Logos – explizit, nicht aus SUPABASE_URL abgeleitet:
#   local    = .data/dev-assets (lokale Dev-DB, Tests; Standard)
#   supabase = Supabase Storage, Bucket tenant-assets (Produktion)
ASSET_STORAGE=local

# ---------------------------------------------------------------
# App
# ---------------------------------------------------------------
# Öffentliche Adresse der App, OHNE Pfad (die App läuft im Root; ein Pfad lässt den
# Build abbrechen). Grundlage für Links in Mails, Redirects und OAuth-Callbacks.
# Produktion: https://meetings.atools.de
#   Pipedrive-Callback: https://meetings.atools.de/api/auth/pipedrive/callback
#   Pipedrive-Panel:    https://meetings.atools.de/panel
APP_BASE_URL=http://localhost:3000
# Host der App (ohne Schema). Leer = Host aus APP_BASE_URL. Produktion: meetings.atools.de
APP_DOMAIN=localhost:3000
# Betriebsart: production | staging | development. Leer = production bei "next start".
# In Produktion sind Dev-Login, /dev/* und ?tenant= immer aus. (Setzt die systemd-Unit.)
APP_ENV=
# "?tenant=<slug>" erlauben (nur Entwicklung/Staging). Produktion: false
ALLOW_TENANT_QUERY_PARAM=true
# Entwickler-Werkzeuge: Dev-Login, /dev/mails, /dev/panel. Produktion: false
DEV_TOOLS_ENABLED=true

# 32 Byte, base64. Erzeugen: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
ENCRYPTION_KEY=

# Benutzer in auth.users anlegen (Nutzerverwaltung) – explizit wählen:
#   local    = lokale Dev-/Testdatenbank (auth.users ist ein Shim)
#   supabase = Supabase Auth-Admin-API (Produktion; nie auth.users per SQL)
AUTH_ADMIN=local

# Absicherung des Cron-Endpunkts /api/cron/outbox (systemd-Timer meetings-cron).
# Zufallswert, z. B.: openssl rand -hex 32
CRON_SECRET=

# ---------------------------------------------------------------
# Pipedrive-App (Developer Hub)
# ---------------------------------------------------------------
# OAuth-App aus dem Pipedrive Developer Hub ("Mit Pipedrive anmelden", Installation).
# Callback-URL im Developer Hub: <APP_BASE_URL>/api/auth/pipedrive/callback
PIPEDRIVE_CLIENT_ID=
PIPEDRIVE_CLIENT_SECRET=
# Geheimnis, mit dem Pipedrive die Tokens der "App settings"-Seite (<APP_BASE_URL>/settings)
# und des Custom Panels (<APP_BASE_URL>/panel) signiert. Leer = Client-Secret.
PIPEDRIVE_JWT_SECRET=
# ---------------------------------------------------------------
# Mailversand
# ---------------------------------------------------------------
# Weg für Einladungen: pipedrive (Standard) | oauth | smtp
#   pipedrive = über das in Pipedrive verbundene Postfach des Mitarbeiters
#               (OAuth-Token aus seinem Login, Pipedrive-App braucht mail-sending:full)
#   oauth     = über sein per Google/Microsoft verbundenes Postfach (Buttons nur dann sichtbar)
#   smtp      = System-Adresse mit dem Namen des Mitarbeiters, Reply-To = Mitarbeiter
# Fällt der Weg aus, gibt es eine Meldung – nie einen stillen Wechsel.
INVITE_MAIL_PROVIDER=pipedrive
# Wie die App über Pipedrive sendet: mcp (Standard, offizieller Pipedrive-MCP-Server
# https://mcp.pipedrive.ai/mcp) | rest (Pipedrive-API mailDrafts, Senden noch unbestätigt)
PIPEDRIVE_MAIL_TRANSPORT=mcp
# System-Absender für Buchungsbestätigungen (immer) und Einladungen bei "smtp".
#   SYSTEM_MAIL_TRANSPORT=smtp (Produktion) | dev (nur DB, /dev/mails; in Produktion gesperrt)
SYSTEM_MAIL_TRANSPORT=dev
SYSTEM_MAIL_FROM=termine@localhost.example
# Anzeigename bei Bestätigungen; leer = Name des Mandanten
SYSTEM_MAIL_FROM_NAME=
SYSTEM_SMTP_HOST=
SYSTEM_SMTP_PORT=587
# true = TLS ab Verbindungsbeginn (465), false = STARTTLS (587)
SYSTEM_SMTP_SECURE=false
SYSTEM_SMTP_USER=
SYSTEM_SMTP_PASS=

# Postfach verbinden (Versand im Namen der Benutzer bzw. der Firma), nur Senden:
#   Google:    OAuth-App (Google Cloud), Scope gmail.send,
#              Redirect-URI <APP_BASE_URL>/api/mail/oauth/google/callback
#   Microsoft: App-Registrierung (Entra ID, mehrinstanzenfähig), Mail.Send + offline_access,
#              Redirect-URI <APP_BASE_URL>/api/mail/oauth/microsoft/callback
# Leer = Button "noch nicht eingerichtet"; SMTP funktioniert ohne.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
# Quelle der Pipedrive-Benutzer in der Nutzerverwaltung – explizit wählen:
#   api  = Pipedrive-API mit dem Token der Installation (Server)
#   fake = Beispiel-Benutzer/-Deals aus seed/tenants.ts (nur lokale Entwicklung)
# Produktion: api
PIPEDRIVE_DIRECTORY=fake
# Nur für Tests eines Produktions-Builds mit Beispieldaten: fake trotz Produktion erlauben.
# Produktion: leer
ALLOW_FAKE_PIPEDRIVE=
