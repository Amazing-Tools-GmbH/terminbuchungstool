# /etc/terminbuchung/env  (Besitzer root, Gruppe terminbuchung, Rechte 0640)
# Wird von systemd (Laufzeit) UND beim Build gelesen – APP_BASE_URL wirkt beim Build!
APP_BASE_URL=https://meetings.atools.de
APP_DOMAIN=meetings.atools.de

# Datenbank (Supabase, Pooler-URL im Transaction-Modus)
SUPABASE_DB_URL=
SUPABASE_URL=https://pkegcsgnyicdxzivnijw.supabase.co
SUPABASE_PROJECT_REF=pkegcsgnyicdxzivnijw
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=
ASSET_STORAGE=supabase
AUTH_ADMIN=supabase

# Geheimnisse (je 32 Byte base64 bzw. zufällig: openssl rand -base64 32)
ENCRYPTION_KEY=
CRON_SECRET=

# Pipedrive-App (Developer Hub)
PIPEDRIVE_CLIENT_ID=
PIPEDRIVE_CLIENT_SECRET=
PIPEDRIVE_JWT_SECRET=
PIPEDRIVE_DIRECTORY=api

# Mailversand
INVITE_MAIL_PROVIDER=pipedrive
SYSTEM_MAIL_TRANSPORT=smtp
SYSTEM_MAIL_FROM=
SYSTEM_MAIL_FROM_NAME=
SYSTEM_SMTP_HOST=
SYSTEM_SMTP_PORT=587
SYSTEM_SMTP_SECURE=false
SYSTEM_SMTP_USER=
SYSTEM_SMTP_PASS=

# nie in Produktion
DEV_TOOLS_ENABLED=false
ALLOW_TENANT_QUERY_PARAM=false
