# Ausschnitt für /etc/caddy/Caddyfile
# Die App setzt die Einbettungs-Regeln selbst:
#   /panel  -> Content-Security-Policy: frame-ancestors 'self' https://*.pipedrive.com
#   sonst   -> X-Frame-Options: SAMEORIGIN
# Darum hier KEIN X-Frame-Options / frame-ancestors setzen – sonst lädt das Panel in Pipedrive nicht.
meetings.atools.de {
	encode zstd gzip

	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "strict-origin-when-cross-origin"
		-Server
	}

	# Host, X-Forwarded-Host/-Proto/-For setzt Caddy automatisch
	reverse_proxy 127.0.0.1:3003
}

# Phase 5 (eigene Kundendomains, z. B. termine.kunde.at per CNAME auf meetings.atools.de):
# On-Demand-TLS, das vor jedem Zertifikat bei der App nachfragt. Der Prüf-Endpunkt
# entsteht in Phase 5 – bis dahin auskommentiert lassen.
#
# {
# 	on_demand_tls {
# 		ask http://127.0.0.1:3003/api/tls/allowed
# 	}
# }
# https:// {
# 	tls {
# 		on_demand
# 	}
# 	reverse_proxy 127.0.0.1:3003
# }
